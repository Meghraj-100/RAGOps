# ============================================================
# RAG Evaluation & Observability Platform — Environment Config
# ============================================================

# --- APPLICATION ---
ENVIRONMENT=development
API_KEY=your-api-key-here
NEXT_PUBLIC_API_KEY=your-api-key-here
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=5
EVAL_REGRESSION_THRESHOLD=0.02

# --- DATABASE ---
DATABASE_URL=postgresql+asyncpg://raguser:ragpass@postgres:5432/ragdb
DATABASE_URL_SYNC=postgresql://raguser:ragpass@postgres:5432/ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass
POSTGRES_DB=ragdb

# --- MODEL ---
GROQ_API_KEY=your-groq-api-key-here
LLM_MODEL=qwen/qwen3.8-27b
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true

# --- CORS / FRONTEND ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=RAG Platform

# --- OBSERVABILITY ---
OTEL_ENABLED=true
OTEL_SERVICE_NAME=rag-platform
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_HEADERS=
PROMETHEUS_ENABLED=true
