# ============================================================
# RAG Evaluation & Observability Platform — Environment Config
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://raguser:ragpass@postgres:5432/ragdb
DATABASE_URL_SYNC=postgresql://raguser:ragpass@postgres:5432/ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass
POSTGRES_DB=ragdb

# --- LLM (Groq — free tier, OpenAI-compatible) ---
GROQ_API_KEY=your-groq-api-key-here
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# --- Embeddings (local sentence-transformers — zero cost) ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384

# --- Reranker (local cross-encoder — zero cost) ---
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true

# --- RAG Configuration ---
CHUNK_SIZE=512
CHUNK_OVERLAP=50
TOP_K=5

# --- API Security ---
API_KEY=your-api-key-here

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=RAG Platform

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4317
OTEL_SERVICE_NAME=rag-platform

# --- Evaluation ---
EVAL_REGRESSION_THRESHOLD=0.02
ALLOW_PAID_MODELS=false
